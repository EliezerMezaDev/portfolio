---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  canonicalUrl?: string;
  jsonLd?: object;
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  canonicalUrl,
  jsonLd,
  noindex = false,
} = Astro.props;

const resolvedCanonical =
  canonicalUrl || new URL(Astro.url.pathname, import.meta.env.SITE).toString();
const ogImageUrl = `${import.meta.env.SITE}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Hides the body until the i18n client script has applied the correct
      language labels. Prevents any flash of English text for non-EN users.
      The script (imported below) sets body.style.visibility = 'visible'.
      On View Transitions navigations, astro:after-swap re-applies this.
    -->
    <style>body { visibility: hidden; }</style>

    <ClientRouter />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Eliezer Meza" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || title} />
    <meta name="twitter:description" content={ogDescription || description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />

    <!--
      Bundled by Vite. Runs after DOMContentLoaded (module semantics).
      Detects browser language, resolves [data-i18n] keys from the correct
      JSON, populates all elements, then makes the body visible.
      Also exposes window.toggleLang() for the header button.
    -->
    <script>
      import "../scripts/i18n-client.ts";
    </script>
  </body>
</html>
