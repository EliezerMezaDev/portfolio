---
interface Props {
  label: string;
  items: string[];
  i18nKey?: string;
}
const { label, items, i18nKey } = Astro.props;
---

<div>
  <h3 class="text-sm font-semibold text-ink mb-2" data-i18n={i18nKey}>{label}</h3>
  <ul class="space-y-1" role="list">
    {items.map((item) => (
      <li class="font-mono text-xs text-muted">{item}</li>
    ))}
  </ul>
</div>
