---
interface Props {
  label: string;
  items: string[];
}
const { label, items } = Astro.props;
---

<div>
  <h3 class="text-sm font-semibold text-ink mb-2">{label}</h3>
  <ul class="space-y-1" role="list">
    {items.map((item) => (
      <li class="font-mono text-xs text-muted">{item}</li>
    ))}
  </ul>
</div>
