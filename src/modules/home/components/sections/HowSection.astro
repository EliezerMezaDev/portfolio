---
import SectionWrapper from "../../../../components/SectionWrapper.astro";
import { frontmatter as en } from "../../../../i18n/en.md";
import { md } from "../../../../utils/md";
---

<SectionWrapper labelledBy="how-heading">
  <h2
    id="how-heading"
    class="text-xl font-semibold text-ink md:mb-8"
    data-i18n="home.howTitle"
    set:html={md(en.home.howTitle)}
  />
  <div class="space-y-6">
    <p
      class="text-muted leading-relaxed"
      data-i18n="home.how1"
      set:html={md(en.home.how1)}
    />
    <p
      class="text-muted leading-relaxed"
      data-i18n="home.how2"
      set:html={md(en.home.how2)}
    />
    <p
      class="text-muted leading-relaxed"
      data-i18n="home.how3"
      set:html={md(en.home.how3)}
    />
    <p
      class="text-muted leading-relaxed"
      data-i18n="home.how4"
      set:html={md(en.home.how4)}
    />
    <p
      class="text-muted leading-relaxed"
      data-i18n="home.how5"
      set:html={md(en.home.how5)}
    />
  </div>
</SectionWrapper>
