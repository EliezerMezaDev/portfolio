---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { frontmatter as en } from "../i18n/en.md";
---

<Base title="404 — Eliezer Meza" description="Page not found." noindex={true}>
  <Header />
  <main id="main-content" class="flex-1 flex items-center">
    <div class="max-w-base mx-auto px-5 py-16">
      <p class="font-mono text-muted text-sm mb-4">404</p>
      <p class="text-ink text-lg">
        <span data-i18n="notFound.text">{en.notFound.text}</span>
        {" "}
        <a
          href="/"
          class="text-accent"
          data-i18n="notFound.link"
          title={en.notFound.linkTitle}
        >
          {en.notFound.link}
        </a>
      </p>
    </div>
  </main>
  <Footer />
</Base>
