---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ExperienceItem from "../modules/cv/components/ExperienceItem.astro";
import SkillItem from "../modules/cv/components/SkillItem.astro";
import { frontmatter as en } from "../i18n/en.md";

const stackItems = {
  frontend: ["JS/TS (ES6+)", "Vue", "Nuxt", "React", "Next.js", "Astro", "SCSS", "Tailwind", "Flutter", "Ionic"],
  backend: ["Node.js", "NestJS", "Express", "Python", "FastAPI", "Bun.js", "Strapi"],
  data: ["PostgreSQL", "Redis", "Cloudinary", "Netlify", "Heroku", "CI/CD"],
};
---

<Base
  title={en.cv.pageTitle}
  description={en.cv.pageDesc}
  canonicalUrl={`${import.meta.env.SITE}/cv`}
>
  <Header />

  <main id="main-content">
    <div class="max-w-base mx-auto px-5 py-12 space-y-12">
      <!-- Identity -->
      <div
        class="flex max-sm:flex-col max-sm:gap-4 items-start justify-between"
      >
        <div>
          <h1 class="text-3xl font-bold text-ink mb-1">Eliezer A. Meza</h1>
          <p class="text-muted font-mono text-sm" data-i18n="cv.jobTitle">
            {en.cv.jobTitle}
          </p>
          <p class="text-muted text-sm mt-1">
            Nueva Esparta, Venezuela · Remote (UTC−4)
          </p>
          <a
            href="mailto:eliezermeza.dev@gmail.com"
            class="font-mono text-accent text-sm hover:underline mt-1 block"
            title="Eliezer Meza — Email"
          >
            eliezermeza.dev@gmail.com
          </a>
        </div>
        <a
          id="cv-download"
          class="primary-btn"
          data-i18n="cv.download"
          href="/docs/eliezermeza_cv_en.pdf"
          target="_blank"
          rel="noopener noreferrer"
          download
          title={en.cv.download}
        >
          {en.cv.download}
        </a>
      </div>

      <!-- Summary -->
      <section aria-labelledby="summary-heading">
        <h2
          id="summary-heading"
          class="text-xs font-semibold uppercase tracking-widest text-muted mb-6"
          data-i18n="cv.summary.heading"
        >
          {en.cv.summary.heading}
        </h2>
        <p class="text-ink leading-relaxed" data-i18n="cv.summary.text">
          {en.cv.summary.text}
        </p>
      </section>

      <!-- Featured Projects -->
      <section aria-labelledby="projects-heading">
        <h2
          id="projects-heading"
          class="text-xs font-semibold uppercase tracking-widest text-muted mb-6"
          data-i18n="cv.projects.heading"
        >
          {en.cv.projects.heading}
        </h2>

        <div class="space-y-8">
          {en.cv.projects.items.map((project, i) => (
            <ExperienceItem job={project} index={i} pathPrefix="cv.projects.items" />
          ))}
        </div>
      </section>

      <!-- Experience -->
      <section aria-labelledby="experience-heading">
        <h2
          id="experience-heading"
          class="text-xs font-semibold uppercase tracking-widest text-muted mb-6"
          data-i18n="cv.experience.heading"
        >
          {en.cv.experience.heading}
        </h2>

        <div class="space-y-8">
          {en.cv.experience.jobs.map((job, i) => (
            <ExperienceItem job={job} index={i} />
          ))}
        </div>
      </section>

      <!-- Education -->
      <section aria-labelledby="education-heading">
        <h2
          id="education-heading"
          class="text-xs font-semibold uppercase tracking-widest text-muted mb-6"
          data-i18n="cv.education.heading"
        >
          {en.cv.education.heading}
        </h2>

        <div class="space-y-8">
          <div>
            <div
              class="flex flex-wrap items-baseline justify-between gap-2 mb-1"
            >
              <h3
                class="font-semibold text-ink"
                data-i18n="cv.education.degree"
              >
                {en.cv.education.degree}
              </h3>
              <span class="font-mono text-xs text-muted"
                >{en.cv.education.period}</span
              >
            </div>
            <p class="text-muted text-sm">
              <a
                href={en.cv.education.universityUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-accent hover:underline"
              >
                {en.cv.education.university}
              </a>
            </p>
            <p class="text-sm text-ink mt-1" data-i18n="cv.education.thesis">
              {en.cv.education.thesis}
            </p>
          </div>

          <div>
            <h4 class="text-ink mb-2" data-i18n="cv.education.certs">
              {en.cv.education.certs}
            </h4>
            <ul class="text-sm text-ink">
              {
                en.cv.education.certList.map((cert, i) => (
                  <li class="text-muted">
                    <a
                      href={cert.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-accent hover:underline"
                      title={cert.name}
                      data-i18n={`cv.education.certList.${i}.name`}
                    >
                      {cert.name}
                    </a>
                    <span class="font-mono text-xs"> — {cert.year}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- Skills -->
      <section aria-labelledby="skills-heading">
        <h2
          id="skills-heading"
          class="text-xs font-semibold uppercase tracking-widest text-muted mb-6"
          data-i18n="cv.skills.heading"
        >
          {en.cv.skills.heading}
        </h2>
        <div class="grid gap-4 sm:grid-cols-3">
          <SkillItem label="Frontend" items={stackItems.frontend} />
          <SkillItem label="Backend" items={stackItems.backend} />
          <SkillItem label={en.cv.skills.data} i18nKey="cv.skills.data" items={stackItems.data} />
        </div>
      </section>

      <!-- Languages -->
      <section aria-labelledby="languages-heading">
        <h2
          id="languages-heading"
          class="text-xs font-semibold uppercase tracking-widest text-muted mb-4"
          data-i18n="cv.languages.heading"
        >
          {en.cv.languages.heading}
        </h2>
        <div class="flex gap-8 text-sm">
          <div>
            <span
              class="font-semibold text-ink"
              data-i18n="cv.languages.spanish"
            >
              {en.cv.languages.spanish}
            </span>
            <span
              class="text-muted ml-2 font-mono text-xs"
              data-i18n="cv.languages.spanishLevel"
            >
              {en.cv.languages.spanishLevel}
            </span>
          </div>
          <div>
            <span
              class="font-semibold text-ink"
              data-i18n="cv.languages.english"
            >
              {en.cv.languages.english}
            </span>
            <span
              class="text-muted ml-2 font-mono text-xs"
              data-i18n="cv.languages.englishLevel"
            >
              {en.cv.languages.englishLevel}
            </span>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Base>

<script>
  function setCvLang() {
    const link = document.getElementById("cv-download");
    const lang = document.documentElement.getAttribute("data-lang") === "es" ? "es" : "en";
    link?.setAttribute("href", `/docs/eliezermeza_cv_${lang}.pdf`);
  }
  setCvLang();
  document.addEventListener("astro:after-swap", setCvLang);
  new MutationObserver(setCvLang).observe(document.documentElement, {
    attributeFilter: ["data-lang"],
  });
</script>
