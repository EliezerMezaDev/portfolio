---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroSection from "../modules/home/components/sections/HeroSection.astro";
import HowSection from "../modules/home/components/sections/HowSection.astro";
import ProjectsSection from "../modules/home/components/sections/ProjectsSection.astro";
import StackSection from "../modules/home/components/sections/StackSection.astro";
import ContactSection from "../modules/home/components/sections/ContactSection.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Eliezer Meza",
  jobTitle: "Full-Stack Engineer",
  email: "eliezermeza.dev@gmail.com",
  url: import.meta.env.SITE,
  sameAs: [
    "https://github.com/EliezerMezaDev/",
    "https://www.linkedin.com/in/eliezer-a-meza-7a1b882b9/",
  ],
  knowsAbout: ["Fintech", "ERP Systems", "AI Agents", "LangGraph", "FastAPI", "Flutter", "Next.js"],
};
---

<Base
  title="Eliezer A Meza — Full-Stack Engineer · Fintech & AI Agents"
  description="Full-stack software engineer specializing in fintech, ERP systems, and production AI agents. Based in Venezuela, available remotely worldwide."
  jsonLd={jsonLd}
>
  <Header />

  <main id="main-content">
    <HeroSection />
    <hr class="bg-line border-0 h-px" />
    <HowSection />
    <hr class="bg-line border-0 h-px" />
    <ProjectsSection projects={projects} />
    <hr class="bg-line border-0 h-px" />
    <StackSection />
    <hr class="bg-line border-0 h-px" />
    <ContactSection />
  </main>

  <Footer />
</Base>
